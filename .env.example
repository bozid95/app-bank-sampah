# =============================================================================
# 1. AKUN ADMIN AWAL (dipakai saat `npm run db:seed`)
# =============================================================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-ini"

# =============================================================================
# 2. DOMAIN & KEAMANAN COOKIE (WAJIB DIISI SESUAI DOMAIN DEPLOY)
# =============================================================================
# Daftar domain/IP untuk mengakses aplikasi (pisahkan koma), tanpa http:// atau https://.
# Contoh VPS dengan domain: ALLOWED_DOMAINS="banksampah.desaku.id,www.banksampah.desaku.id"
# Contoh VPS lewat IP saja: ALLOWED_DOMAINS="localhost,127.0.0.1,103.xxx.xxx.xxx"
# PENTING: Nilai dibaca saat build — setelah mengubahnya, build ulang image / redeploy!
ALLOWED_DOMAINS="localhost,127.0.0.1"

# Kosongkan agar otomatis (secure jika diakses via HTTPS / reverse proxy HTTPS).
# Isi "false" HANYA jika di VPS diakses lewat HTTP biasa (tanpa SSL/HTTPS).
COOKIE_SECURE=""

# =============================================================================
# 3A. MODE VPS SENDIRI (Docker Compose — `docker compose up -d --build`)
# =============================================================================
# Jika memakai `docker-compose.yml`, cukup isi variabel di bawah ini.
# DATABASE_URL di dalam container otomatis mengarah ke service PostgreSQL (`db`).
APP_PORT="4321"
POSTGRES_USER="banksampah"
POSTGRES_PASSWORD="ganti-password-db-yang-kuat"
POSTGRES_DB="banksampah"

# =============================================================================
# 3B. MODE VERCEL + NEON / LOKAL TANPA DOCKER
# =============================================================================
# Ambil dari dashboard Neon (https://neon.tech) → Connect:
# - DATABASE_URL          = connection string "Pooled" (host berisi "-pooler"), dipakai aplikasi
# - DATABASE_URL_UNPOOLED = connection string langsung (tanpa "-pooler"), dipakai prisma migrate
# Di Vercel, kedua variabel ini terisi otomatis jika Neon dipasang lewat Vercel → Storage.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
