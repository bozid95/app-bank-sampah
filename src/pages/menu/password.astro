---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma';
import { destroyOtherSessions, hashPassword, verifyPassword } from '../../lib/auth';
import { flash } from '../../lib/format';
import { PasswordForm } from '../../components/views/PasswordForm';

const me = Astro.locals.user!;
let error = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const get = (k: string) => (typeof fd.get(k) === 'string' ? (fd.get(k) as string) : '');
  const currentPassword = get('currentPassword');
  const newPassword = get('newPassword');
  const confirmPassword = get('confirmPassword');

  const user = await prisma.user.findUniqueOrThrow({ where: { id: me.id } });
  if (currentPassword.length > 72 || !(await verifyPassword(currentPassword, user.passwordHash))) {
    error = 'Password lama salah.';
  } else if (newPassword.length < 8 || newPassword.length > 72) {
    error = 'Password baru harus 8–72 karakter.';
  } else if (newPassword !== confirmPassword) {
    error = 'Konfirmasi password baru tidak sama.';
  } else {
    await prisma.user.update({ where: { id: me.id }, data: { passwordHash: await hashPassword(newPassword) } });
    await destroyOtherSessions(me.id, Astro.cookies);
    return Astro.redirect(flash('/menu', 'ok', 'Password berhasil diubah.'));
  }
}
---

<Layout title="Ubah Password" back="/menu" form>
  <h1>Ubah Password</h1>
  <p class="page-desc">Ganti password akun {me.username}.</p>
  <div class="max-w-xl">
    <PasswordForm error={error} />
  </div>
</Layout>
